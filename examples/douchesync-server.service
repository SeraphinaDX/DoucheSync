[Unit]
Description=DoucheSync discovery server
After=network.target

[Service]
Type=simple
User=douchesync
Group=douchesync
ExecStart=/usr/local/bin/DoucheSync server -config=/etc/douchesync/server.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
